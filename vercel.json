{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/animated_learn_:id",
      "destination": "/animated_learn_:id/index.html"
    },
    {
      "source": "/animated_learn_:id/",
      "destination": "/animated_learn_:id/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

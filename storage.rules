rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    // Media assets: Images (Avatars, Diagrams, Badges, Thumbnails)
    match /images/{allPaths=**} {
      allow read: if true; // Publicly readable for fast course viewing
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024 // max 10MB
                   && request.resource.contentType.matches('image/.*');
    }

    // Educational Videos: Lecture clips, concept demonstrations
    match /videos/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 100 * 1024 * 1024 // max 100MB
                   && request.resource.contentType.matches('video/.*');
    }

    // Documents: PDFs, PPTs, syllabi, worksheets
    match /documents/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 25 * 1024 * 1024 // max 25MB
                   && (request.resource.contentType.matches('application/pdf') 
                       || request.resource.contentType.matches('application/vnd.*')
                       || request.resource.contentType.matches('text/.*'));
    }

    // Animations: Lottie JSON files, interactive visualizers
    match /animations/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated()
                   && request.resource.size < 10 * 1024 * 1024; // max 10MB
    }

    // General user uploads
    match /users/{userId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAuthenticated();
    }
  }
}

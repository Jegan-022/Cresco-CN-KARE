{
  "entities": {
    "courses": {
      "title": "Course Definition",
      "description": "Top-level syllabus course metadata",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "department": { "type": "string" },
        "totalUnits": { "type": "number" },
        "totalModules": { "type": "number" },
        "totalXP": { "type": "number" },
        "units": { "type": "array" },
        "thumbnailUrl": { "type": "string" },
        "syllabusUrl": { "type": "string" }
      },
      "required": ["id", "code", "title"]
    },
    "units": {
      "title": "Course Unit",
      "description": "Curriculum units e.g. Unit 3, 4, 5",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "courseId": { "type": "string" },
        "unitNumber": { "type": "number" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "totalModules": { "type": "number" },
        "totalXP": { "type": "number" },
        "bossId": { "type": "string" }
      },
      "required": ["id", "courseId", "unitNumber", "title"]
    },
    "levels": {
      "title": "XP Level Tier",
      "description": "Student gamification tier definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "levelNumber": { "type": "number" },
        "title": { "type": "string" },
        "minXP": { "type": "number" },
        "maxXP": { "type": "number" },
        "rewards": { "type": "object" }
      },
      "required": ["id", "levelNumber", "title", "minXP", "maxXP"]
    },
    "lessons": {
      "title": "Curriculum Module / Lesson",
      "description": "30 interactive pedagogical networking modules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unitId": { "type": "string" },
        "title": { "type": "string" },
        "order": { "type": "number" },
        "durationMinutes": { "type": "number" },
        "xpReward": { "type": "number" },
        "pedagogy": { "type": "object" },
        "keyTakeaways": { "type": "array" }
      },
      "required": ["id", "unitId", "title"]
    },
    "concepts": {
      "title": "Core Concept Card",
      "description": "Atomic network concept definition with analogy",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unitId": { "type": "string" },
        "term": { "type": "string" },
        "definition": { "type": "string" },
        "analogy": { "type": "string" },
        "keyPoints": { "type": "array" }
      },
      "required": ["id", "unitId", "term", "definition"]
    },
    "questions": {
      "title": "Quiz / Drill Question",
      "description": "Multiple choice or fill-in drill question",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "question": { "type": "string" },
        "options": { "type": "array" },
        "correctIndex": { "type": "number" },
        "explanation": { "type": "string" },
        "xpReward": { "type": "number" }
      },
      "required": ["id", "question", "options", "correctIndex"]
    },
    "flashcards": {
      "title": "Quick Reference Flashcard",
      "description": "Front/back quick recall item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "front": { "type": "string" },
        "back": { "type": "string" },
        "tag": { "type": "string" }
      },
      "required": ["id", "front", "back"]
    },
    "activities": {
      "title": "Interactive Lab Activity",
      "description": "Packet tracer, subnet calculator, or protocol drill",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "instructions": { "type": "string" },
        "xpReward": { "type": "number" }
      },
      "required": ["id", "type", "title"]
    },
    "missions": {
      "title": "Daily / Weekly Mission",
      "description": "Goal-driven learning quests with XP bonus",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "targetCount": { "type": "number" },
        "xpReward": { "type": "number" }
      },
      "required": ["id", "title", "xpReward"]
    },
    "bosses": {
      "title": "Unit Boss Challenge",
      "description": "Cumulative arena exam entity",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "unitId": { "type": "string" },
        "bossName": { "type": "string" },
        "hp": { "type": "number" },
        "xpReward": { "type": "number" }
      },
      "required": ["id", "unitId", "bossName"]
    },
    "users": {
      "title": "User Profile",
      "description": "Student or instructor account",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "studentId": { "type": "string" },
        "role": { "type": "string" },
        "totalXP": { "type": "number" },
        "streak": { "type": "number" }
      },
      "required": ["uid", "email"]
    },
    "userProgress": {
      "title": "User Curriculum Progress",
      "description": "Module completions and unit percentages",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "courseId": { "type": "string" },
        "completedLessons": { "type": "array" },
        "overallProgressPercent": { "type": "number" }
      },
      "required": ["id", "userId", "courseId"]
    },
    "userMastery": {
      "title": "Concept Retention Mastery",
      "description": "Spaced repetition concept retention scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "conceptId": { "type": "string" },
        "masteryScore": { "type": "number" }
      },
      "required": ["id", "userId", "conceptId"]
    },
    "quizAttempts": {
      "title": "Quiz Attempt Audit Record",
      "description": "Historical audit of quiz submissions and scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "quizId": { "type": "string" },
        "score": { "type": "number" },
        "percentage": { "type": "number" },
        "passed": { "type": "boolean" }
      },
      "required": ["id", "userId", "quizId", "score"]
    },
    "achievements": {
      "title": "Gamification Achievement Badge",
      "description": "Milestone achievement definition",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "code": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "xpReward": { "type": "number" }
      },
      "required": ["id", "code", "title"]
    },
    "students": {
      "title": "Student Progress Record (Legacy/Leaderboard)",
      "description": "Student academic progress, XP, streak, and curriculum metrics",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "studentId": { "type": "string" },
        "totalXP": { "type": "number" },
        "overallProgress": { "type": "number" }
      },
      "required": ["uid", "email"]
    }
  },
  "firestore": {
    "/courses/{courseId}": { "entity": "courses" },
    "/units/{unitId}": { "entity": "units" },
    "/levels/{levelId}": { "entity": "levels" },
    "/lessons/{lessonId}": { "entity": "lessons" },
    "/concepts/{conceptId}": { "entity": "concepts" },
    "/questions/{questionId}": { "entity": "questions" },
    "/flashcards/{flashcardId}": { "entity": "flashcards" },
    "/activities/{activityId}": { "entity": "activities" },
    "/missions/{missionId}": { "entity": "missions" },
    "/bosses/{bossId}": { "entity": "bosses" },
    "/users/{userId}": { "entity": "users" },
    "/userProgress/{progressId}": { "entity": "userProgress" },
    "/userMastery/{masteryId}": { "entity": "userMastery" },
    "/quizAttempts/{attemptId}": { "entity": "quizAttempts" },
    "/achievements/{achievementId}": { "entity": "achievements" },
    "/students/{studentId}": { "entity": "students" }
  },
  "storage": {
    "/images/{path}": "Images, avatars, diagrams, badges, course thumbnails",
    "/videos/{path}": "Lecture videos, protocol animations, video drills",
    "/documents/{path}": "PDFs, PPTs, slides, syllabus, worksheets",
    "/animations/{path}": "Lottie animations, packet flow visuals"
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real-time student leaderboard & progress collection
    match /students/{studentId} {
      // Allow public read so all enrolled cohort members and friends see live standings
      allow read: if true;
      // Allow students to save and update their progress & XP
      allow write: if request.auth != null || (studentId is string && studentId.size() > 0);
    }

    // Unique student username registry for open registration
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null || (username is string && username.size() > 0);
    }

    // User authentication profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dynamic curriculum, courses, units, and interactive learning modules
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /curriculum_units/{unitId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /modules/{moduleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /course_management/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default fallback access
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}

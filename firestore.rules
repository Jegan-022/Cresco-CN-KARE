rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Real-time student leaderboard collection
    match /students/{studentId} {
      // Allow public read so all enrolled cohort members and friends see live standings
      allow read: if true;
      // Allow students to save and update their progress & XP
      allow write: if request.auth != null || (studentId is string && studentId.size() > 0);
    }

    // Unique student username registry for open registration
    match /usernames/{username} {
      allow read: if true;
      allow write: if request.auth != null || (username is string && username.size() > 0);
    }

    // User account profiles
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null || (userId is string && userId.size() > 0);
    }

    // Course units, modules, quizzes, and flashcards curriculum content
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /curriculum_modules/{moduleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /quizzes/{quizId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /flashcards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default authenticated access for user documents and quiz records
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}


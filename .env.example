# APP_URL: The URL where this applet is hosted (optional, for self-referential links)
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: Base URL for backend API requests. Leave empty to use relative paths (same host).
VITE_API_BASE_URL=""

# Backend Gemini AI Tutor API Key (Step 23 - Server-side only, never exposed in client bundles)
GEMINI_API_KEY="your-gemini-api-key-here"

# Optional Gemini Model identifier (defaults to gemini-1.5-flash)
GEMINI_MODEL="gemini-1.5-flash"

# APP_URL: The URL where this applet is hosted (optional, for self-referential links)
APP_URL="http://localhost:3000"

# VITE_API_BASE_URL: Base URL for backend API requests. Leave empty to use relative paths (same host).
VITE_API_BASE_URL=""

# Backend Groq AI Tutor API Key (Server-side only, never exposed in client bundles)
GROQ_API_KEY="your-groq-api-key-here"

# Optional Groq Model identifier (defaults to llama-3.3-70b-versatile)
GROQ_MODEL="llama-3.3-70b-versatile"
